# syntax=docker/dockerfile:1.7
# Routine API changes never compile C++. Update version and digest together.
ARG PREFLIGHT_VERSION=1.4.1
FROM ubuntu:24.04 AS release
ARG PREFLIGHT_VERSION
ARG PREFLIGHT_SHA256=1f71749f68836933df2e21a4725c08b3b7ea5a9905a3d049fa76a6b385364f12
ARG TARGETARCH=amd64
RUN test "$TARGETARCH" = amd64
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/preflight
RUN curl --fail --location --retry 3 -o release.AppImage "https://github.com/oozebot/preFlight/releases/download/v${PREFLIGHT_VERSION}/preFlight-${PREFLIGHT_VERSION}-linux-amd64.AppImage" \
    && echo "${PREFLIGHT_SHA256}  release.AppImage" | sha256sum -c - \
    && chmod +x release.AppImage && ./release.AppImage --appimage-extract >/dev/null && rm release.AppImage && chmod -R a+rX squashfs-root
FROM ubuntu:24.04
ARG PREFLIGHT_VERSION
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PORT=8090 PREFLIGHT_API_PREFIX=/api/slicer \
    PREFLIGHT_BIN=/opt/preflight/squashfs-root/AppRun PREFLIGHT_WORK_DIR=/work PREFLIGHT_VERSION=${PREFLIGHT_VERSION}
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-aiohttp libgtk-3-0 libsecret-1-0 libgl1 libglu1-mesa \
    libdbus-1-3 libx11-6 libxext6 libxi6 libxrandr2 libxrender1 libxtst6 libxxf86vm1 libwayland-server0 libegl1 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=release /opt/preflight /opt/preflight
COPY LICENSE /opt/preflight/LICENSE
COPY slicer_service/ /app/
COPY tools/smoke_slice.py /app/smoke_slice.py
RUN useradd -m -u 10001 preflight && mkdir /work && chown preflight:preflight /work
USER preflight
WORKDIR /app
RUN python3 /app/smoke_slice.py
ARG SOURCE_REV=local
LABEL org.opencontainers.image.source="https://github.com/Modovolo/preFlight" \
    org.opencontainers.image.revision=${SOURCE_REV}
EXPOSE 8090
CMD ["python3", "/app/app.py"]
